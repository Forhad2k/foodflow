// FoodFlow database schema.
// Conventions:
//  - Money is stored as integer minor units (paisa for BDT). Never floats.
//  - Geography columns declared as Unsupported(...) are GENERATED from lat/lng in the
//    init migration (see prisma/migrations/0001_init/migration.sql, PostGIS section).
//    Application code reads/writes lat/lng; PostGIS queries use the generated column via $queryRaw.
//  - Credentials are isolated from public profile data (UserCredential vs Profile).

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [postgis]
}

// ───────────────────────────── Enums ─────────────────────────────

enum Role {
  CUSTOMER
  RESTAURANT_OWNER
  RIDER
  ADMIN
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  DELETED
}

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
  SUSPENDED
}

enum VehicleType {
  BICYCLE
  MOTORCYCLE
  CAR
}

enum DocumentType {
  NATIONAL_ID
  DRIVING_LICENSE
  VEHICLE_REGISTRATION
  SELFIE
  OTHER
}

enum ZoneType {
  RADIUS
  POLYGON
}

enum OrderStatus {
  PENDING_PAYMENT
  PLACED
  RESTAURANT_ACCEPTED
  PREPARING
  READY_FOR_PICKUP
  RIDER_ASSIGNED
  PICKED_UP
  ON_THE_WAY
  DELIVERED
  REJECTED_BY_RESTAURANT
  CANCELLED
  PAYMENT_FAILED
  DELIVERY_FAILED
}

enum PaymentMethod {
  CASH_ON_DELIVERY
  ONLINE
}

enum PaymentStatus {
  PENDING
  SUCCESSFUL
  FAILED
  CANCELLED
  REFUNDED
}

enum AssignmentStatus {
  OFFERED
  ACCEPTED
  REJECTED
  EXPIRED
  CANCELLED
  COMPLETED
  FAILED
}

enum RefundStatus {
  REQUESTED
  APPROVED
  REJECTED
  PROCESSED
  FAILED
}

enum CouponType {
  PERCENTAGE
  FIXED_AMOUNT
  FREE_DELIVERY
}

enum PayoutStatus {
  PENDING
  PROCESSING
  PAID
  FAILED
}

enum NotificationType {
  ORDER_UPDATE
  ASSIGNMENT
  PAYMENT
  REFUND
  PROMOTION
  SUPPORT
  SYSTEM
}

enum TicketCategory {
  ORDER_ISSUE
  MISSING_ITEM
  DELIVERY_COMPLAINT
  REFUND
  PAYMENT
  ACCOUNT
  DISPUTE
  OTHER
}

enum TicketStatus {
  OPEN
  IN_PROGRESS
  AWAITING_CUSTOMER
  RESOLVED
  CLOSED
}

enum ReportStatus {
  OPEN
  REVIEWED
  DISMISSED
}

// ───────────────────── Identity, auth, profiles ─────────────────────

model User {
  id              String     @id @default(uuid()) @db.Uuid
  email           String     @unique // always stored lower-cased
  phone           String?    @unique
  role            Role
  status          UserStatus @default(ACTIVE)
  emailVerifiedAt DateTime?
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  credential          UserCredential?
  profile             Profile?
  sessions            Session[]
  passwordResetTokens PasswordResetToken[]
  addresses           Address[]
  riderProfile        RiderProfile?
  restaurants         Restaurant[]
  cart                Cart?
  orders              Order[]              @relation("CustomerOrders")
  orderStatusChanges  OrderStatusHistory[]
  favorites           Favorite[]
  reviews             Review[]
  notifications       Notification[]
  couponRedemptions   CouponRedemption[]
  chatMessages        ChatMessage[]
  chatReports         ChatMessageReport[]
  tickets             SupportTicket[]      @relation("TicketCreator")
  assignedTickets     SupportTicket[]      @relation("TicketAssignee")
  ticketMessages      TicketMessage[]
  auditLogs           AuditLog[]

  @@index([role, status])
  @@map("users")
}

/// Secrets live apart from the public profile so ordinary profile queries can never leak them.
model UserCredential {
  userId            String    @id @db.Uuid
  passwordHash      String
  passwordChangedAt DateTime  @default(now())
  failedLoginCount  Int       @default(0)
  lockedUntil       DateTime?
  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_credentials")
}

model Profile {
  userId           String   @id @db.Uuid
  fullName         String
  avatarUrl        String?
  marketingConsent Boolean  @default(false)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("profiles")
}

/// One row per refresh token. Rotation creates a new row in the same family;
/// presenting an already-revoked token revokes the entire family (reuse detection).
model Session {
  id               String    @id @default(uuid()) @db.Uuid
  userId           String    @db.Uuid
  familyId         String    @db.Uuid
  refreshTokenHash String    @unique // sha256 of the opaque token; the raw token is never stored
  userAgent        String?
  ip               String?
  expiresAt        DateTime
  revokedAt        DateTime?
  replacedById     String?   @db.Uuid
  createdAt        DateTime  @default(now())
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, revokedAt])
  @@index([familyId])
  @@index([expiresAt])
  @@map("sessions")
}

model PasswordResetToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @db.Uuid
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("password_reset_tokens")
}

model Address {
  id           String    @id @default(uuid()) @db.Uuid
  userId       String    @db.Uuid
  label        String // "Home", "Office"
  line1        String
  line2        String?
  area         String?
  city         String
  postalCode   String?
  lat          Float
  lng          Float
  instructions String?
  isDefault    Boolean   @default(false)
  deletedAt    DateTime? // soft delete: orders keep their own address snapshot
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, deletedAt])
  @@map("addresses")
}

// ───────────────────────────── Riders ─────────────────────────────

model RiderProfile {
  userId              String                                @id @db.Uuid
  approvalStatus      ApprovalStatus                        @default(PENDING)
  vehicleType         VehicleType?
  vehiclePlate        String?
  isOnline            Boolean                               @default(false)
  maxActiveDeliveries Int                                   @default(1)
  // Last known position, refreshed by the tracking service. Short-lived operational data.
  lastLat             Float?
  lastLng             Float?
  lastLocationAt      DateTime?
  location            Unsupported("geography(Point,4326)")? // GENERATED from lastLat/lastLng
  ratingAvg           Float                                 @default(0)
  ratingCount         Int                                   @default(0)
  offersReceived      Int                                   @default(0)
  offersAccepted      Int                                   @default(0)
  reviewedById        String?                               @db.Uuid
  reviewedAt          DateTime?
  rejectionReason     String?
  createdAt           DateTime                              @default(now())
  updatedAt           DateTime                              @updatedAt

  user        User                        @relation(fields: [userId], references: [id], onDelete: Cascade)
  documents   RiderVerificationDocument[]
  assignments DeliveryAssignment[]
  earnings    RiderEarning[]
  reviews     Review[]

  @@index([approvalStatus, isOnline])
  @@index([location], type: Gist)
  @@map("rider_profiles")
}

model RiderVerificationDocument {
  id              String         @id @default(uuid()) @db.Uuid
  riderId         String         @db.Uuid
  type            DocumentType
  storageKey      String // object-storage key; files are served via short-lived signed URLs only
  status          ApprovalStatus @default(PENDING)
  reviewedById    String?        @db.Uuid
  reviewedAt      DateTime?
  rejectionReason String?
  createdAt       DateTime       @default(now())
  rider           RiderProfile   @relation(fields: [riderId], references: [userId], onDelete: Cascade)

  @@unique([riderId, type]) // one current document per type; re-uploading replaces it
  @@index([riderId])
  @@map("rider_verification_documents")
}

// ─────────────────────── Restaurants & menus ───────────────────────

model CuisineType {
  id          String              @id @default(uuid()) @db.Uuid
  name        String              @unique
  slug        String              @unique
  restaurants RestaurantCuisine[]

  @@map("cuisine_types")
}

model Restaurant {
  id                   String                                @id @default(uuid()) @db.Uuid
  ownerId              String                                @db.Uuid
  name                 String
  slug                 String                                @unique
  description          String?
  phone                String
  logoUrl              String?
  coverUrl             String?
  addressLine          String
  city                 String
  lat                  Float
  lng                  Float
  location             Unsupported("geography(Point,4326)")? // GENERATED from lat/lng
  approvalStatus       ApprovalStatus                        @default(PENDING)
  isPaused             Boolean                               @default(false) // owner-controlled "temporarily closed"
  avgPrepMinutes       Int                                   @default(20)
  minOrderMinor        Int                                   @default(0)
  baseDeliveryFeeMinor Int                                   @default(0)
  commissionBps        Int? // null → platform default from PlatformSetting
  priceTier            Int                                   @default(2) // 1..4, used by the price filter
  ratingAvg            Float                                 @default(0)
  ratingCount          Int                                   @default(0)
  reviewedById         String?                               @db.Uuid
  reviewedAt           DateTime?
  rejectionReason      String?
  createdAt            DateTime                              @default(now())
  updatedAt            DateTime                              @updatedAt

  owner      User                @relation(fields: [ownerId], references: [id], onDelete: Restrict)
  cuisines   RestaurantCuisine[]
  zones      DeliveryZone[]
  hours      OperatingHour[]
  categories MenuCategory[]
  items      MenuItem[]
  orders     Order[]
  coupons    Coupon[]
  favorites  Favorite[]
  reviews    Review[]
  earnings   RestaurantEarning[]
  carts      Cart[]

  @@index([ownerId])
  @@index([approvalStatus, isPaused])
  @@index([location], type: Gist)
  @@map("restaurants")
}

model RestaurantCuisine {
  restaurantId String      @db.Uuid
  cuisineId    String      @db.Uuid
  restaurant   Restaurant  @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  cuisine      CuisineType @relation(fields: [cuisineId], references: [id], onDelete: Cascade)

  @@id([restaurantId, cuisineId])
  @@map("restaurant_cuisines")
}

/// Delivery eligibility = point inside an active zone (radius around the restaurant, or polygon).
/// Proximity alone never implies deliverability.
model DeliveryZone {
  id               String                                  @id @default(uuid()) @db.Uuid
  restaurantId     String                                  @db.Uuid
  name             String
  type             ZoneType
  radiusMeters     Int? // RADIUS zones
  polygon          Unsupported("geography(Polygon,4326)")? // POLYGON zones (set via raw SQL)
  deliveryFeeMinor Int? // overrides restaurant base fee when set
  minOrderMinor    Int? // overrides restaurant minimum when set
  isActive         Boolean                                 @default(true)
  createdAt        DateTime                                @default(now())
  restaurant       Restaurant                              @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  @@index([restaurantId, isActive])
  @@index([polygon], type: Gist)
  @@map("delivery_zones")
}

model OperatingHour {
  id           String     @id @default(uuid()) @db.Uuid
  restaurantId String     @db.Uuid
  dayOfWeek    Int // 0 = Sunday … 6 = Saturday, interpreted in restaurant-local time (Asia/Dhaka by default)
  opensAtMin   Int // minutes after local midnight
  closesAtMin  Int // may exceed 1440 for after-midnight closing
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  @@unique([restaurantId, dayOfWeek, opensAtMin])
  @@map("operating_hours")
}

model MenuCategory {
  id           String     @id @default(uuid()) @db.Uuid
  restaurantId String     @db.Uuid
  name         String
  sortOrder    Int        @default(0)
  isActive     Boolean    @default(true)
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  items        MenuItem[]

  @@index([restaurantId, sortOrder])
  @@map("menu_categories")
}

model MenuItem {
  id             String    @id @default(uuid()) @db.Uuid
  restaurantId   String    @db.Uuid
  categoryId     String    @db.Uuid
  name           String
  description    String?
  basePriceMinor Int
  isAvailable    Boolean   @default(true)
  stockQuantity  Int? // null = unlimited
  sortOrder      Int       @default(0)
  deletedAt      DateTime? // soft delete keeps historical references valid
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  restaurant  Restaurant      @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  category    MenuCategory    @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  images      MenuItemImage[]
  variants    ItemVariant[]
  addonGroups AddonGroup[]
  cartItems   CartItem[]
  orderItems  OrderItem[]

  @@index([restaurantId, categoryId, isAvailable])
  @@map("menu_items")
}

model MenuItemImage {
  id         String   @id @default(uuid()) @db.Uuid
  menuItemId String   @db.Uuid
  url        String
  sortOrder  Int      @default(0)
  menuItem   MenuItem @relation(fields: [menuItemId], references: [id], onDelete: Cascade)

  @@index([menuItemId])
  @@map("menu_item_images")
}

model ItemVariant {
  id          String     @id @default(uuid()) @db.Uuid
  menuItemId  String     @db.Uuid
  name        String // "Large", "Spicy"
  priceMinor  Int // absolute price for this variant
  isDefault   Boolean    @default(false)
  isAvailable Boolean    @default(true)
  menuItem    MenuItem   @relation(fields: [menuItemId], references: [id], onDelete: Cascade)
  cartItems   CartItem[]

  @@index([menuItemId])
  @@map("item_variants")
}

model AddonGroup {
  id         String   @id @default(uuid()) @db.Uuid
  menuItemId String   @db.Uuid
  name       String // "Extra toppings"
  minSelect  Int      @default(0)
  maxSelect  Int      @default(1)
  menuItem   MenuItem @relation(fields: [menuItemId], references: [id], onDelete: Cascade)
  addons     Addon[]

  @@index([menuItemId])
  @@map("addon_groups")
}

model Addon {
  id          String          @id @default(uuid()) @db.Uuid
  groupId     String          @db.Uuid
  name        String
  priceMinor  Int             @default(0)
  isAvailable Boolean         @default(true)
  group       AddonGroup      @relation(fields: [groupId], references: [id], onDelete: Cascade)
  cartAddons  CartItemAddon[]

  @@index([groupId])
  @@map("addons")
}

// ───────────────────────────── Cart ─────────────────────────────

model Cart {
  id           String      @id @default(uuid()) @db.Uuid
  userId       String      @unique @db.Uuid
  restaurantId String?     @db.Uuid // MVP: a cart holds items from exactly one restaurant
  couponCode   String?
  updatedAt    DateTime    @updatedAt
  user         User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  restaurant   Restaurant? @relation(fields: [restaurantId], references: [id], onDelete: SetNull)
  items        CartItem[]

  @@map("carts")
}

model CartItem {
  id         String          @id @default(uuid()) @db.Uuid
  cartId     String          @db.Uuid
  menuItemId String          @db.Uuid
  variantId  String?         @db.Uuid
  quantity   Int
  notes      String?
  createdAt  DateTime        @default(now())
  cart       Cart            @relation(fields: [cartId], references: [id], onDelete: Cascade)
  menuItem   MenuItem        @relation(fields: [menuItemId], references: [id], onDelete: Cascade)
  variant    ItemVariant?    @relation(fields: [variantId], references: [id], onDelete: SetNull)
  addons     CartItemAddon[]

  @@index([cartId])
  @@map("cart_items")
}

model CartItemAddon {
  cartItemId String   @db.Uuid
  addonId    String   @db.Uuid
  quantity   Int      @default(1)
  cartItem   CartItem @relation(fields: [cartItemId], references: [id], onDelete: Cascade)
  addon      Addon    @relation(fields: [addonId], references: [id], onDelete: Cascade)

  @@id([cartItemId, addonId])
  @@map("cart_item_addons")
}

// ───────────────────────────── Orders ─────────────────────────────

model Order {
  id                   String        @id @default(uuid()) @db.Uuid
  orderNumber          String        @unique // human-friendly, e.g. FF-240915-7K3Q
  customerId           String        @db.Uuid
  restaurantId         String        @db.Uuid
  status               OrderStatus   @default(PLACED)
  paymentMethod        PaymentMethod
  idempotencyKey       String // client-supplied; (customerId, key) is unique → no duplicate orders
  restaurantName       String // snapshot
  currency             String        @default("BDT")
  subtotalMinor        Int
  deliveryFeeMinor     Int
  serviceFeeMinor      Int
  discountMinor        Int           @default(0)
  taxMinor             Int           @default(0)
  totalMinor           Int
  commissionBps        Int // snapshot of the commission rate applied to this order
  couponId             String?       @db.Uuid
  couponCode           String? // snapshot
  contactPhone         String
  customerNote         String?
  deliveryInstructions String?
  estimatedPrepMinutes Int?
  estimatedDeliveryAt  DateTime?
  cancelReason         String?
  cancelledByRole      Role?
  version              Int           @default(0) // optimistic concurrency token for transitions
  dispatchResetAt      DateTime? // admin 'redispatch' starts a fresh offer round
  placedAt             DateTime      @default(now())
  acceptedAt           DateTime?
  readyAt              DateTime?
  pickedUpAt           DateTime?
  deliveredAt          DateTime?
  cancelledAt          DateTime?
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt

  customer          User                  @relation("CustomerOrders", fields: [customerId], references: [id], onDelete: Restrict)
  restaurant        Restaurant            @relation(fields: [restaurantId], references: [id], onDelete: Restrict)
  coupon            Coupon?               @relation(fields: [couponId], references: [id], onDelete: SetNull)
  deliveryAddress   OrderDeliveryAddress?
  items             OrderItem[]
  history           OrderStatusHistory[]
  assignments       DeliveryAssignment[]
  chatRoom          OrderChatRoom?
  payments          Payment[]
  refunds           Refund[]
  review            Review?
  tickets           SupportTicket[]
  restaurantEarning RestaurantEarning?
  riderEarning      RiderEarning?
  couponRedemption  CouponRedemption?

  @@unique([customerId, idempotencyKey])
  @@index([customerId, createdAt(sort: Desc)])
  @@index([restaurantId, status, createdAt(sort: Desc)])
  @@index([status, createdAt])
  @@map("orders")
}

/// Immutable address snapshot — later edits/deletes of saved addresses never alter receipts.
model OrderDeliveryAddress {
  orderId      String  @id @db.Uuid
  label        String?
  line1        String
  line2        String?
  area         String?
  city         String
  lat          Float
  lng          Float
  contactName  String
  contactPhone String
  order        Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@map("order_delivery_addresses")
}

/// Immutable purchase snapshot. menuItemId is informational only and may be nulled.
model OrderItem {
  id              String           @id @default(uuid()) @db.Uuid
  orderId         String           @db.Uuid
  menuItemId      String?          @db.Uuid
  nameSnapshot    String
  variantSnapshot String?
  unitPriceMinor  Int // base/variant price, add-ons excluded
  quantity        Int
  lineTotalMinor  Int // (unit + add-ons) × quantity
  notes           String?
  order           Order            @relation(fields: [orderId], references: [id], onDelete: Cascade)
  menuItem        MenuItem?        @relation(fields: [menuItemId], references: [id], onDelete: SetNull)
  addons          OrderItemAddon[]

  @@index([orderId])
  @@map("order_items")
}

model OrderItemAddon {
  id           String    @id @default(uuid()) @db.Uuid
  orderItemId  String    @db.Uuid
  nameSnapshot String
  priceMinor   Int
  quantity     Int       @default(1)
  orderItem    OrderItem @relation(fields: [orderItemId], references: [id], onDelete: Cascade)

  @@index([orderItemId])
  @@map("order_item_addons")
}

model OrderStatusHistory {
  id         String       @id @default(uuid()) @db.Uuid
  orderId    String       @db.Uuid
  fromStatus OrderStatus?
  toStatus   OrderStatus
  actorId    String?      @db.Uuid // null for SYSTEM transitions
  actorRole  Role?
  reason     String?
  createdAt  DateTime     @default(now())
  order      Order        @relation(fields: [orderId], references: [id], onDelete: Cascade)
  actor      User?        @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([orderId, createdAt])
  @@map("order_status_history")
}

// ─────────────────── Delivery assignment & tracking ───────────────────

model DeliveryAssignment {
  id           String                @id @default(uuid()) @db.Uuid
  orderId      String                @db.Uuid
  riderId      String                @db.Uuid
  status       AssignmentStatus      @default(OFFERED)
  attempt      Int                   @default(1)
  offeredAt    DateTime              @default(now())
  expiresAt    DateTime // offer deadline
  respondedAt  DateTime?
  rejectReason String?
  order        Order                 @relation(fields: [orderId], references: [id], onDelete: Cascade)
  rider        RiderProfile          @relation(fields: [riderId], references: [userId], onDelete: Restrict)
  locations    RiderLocationUpdate[]
  chatRoom     OrderChatRoom?

  @@index([orderId, status])
  @@index([riderId, status])
  @@index([status, expiresAt]) // expiry sweeper
  @@map("delivery_assignments")
}

/// Short-lived. A scheduled job deletes rows older than LOCATION_RETENTION_HOURS.
model RiderLocationUpdate {
  id           BigInt             @id @default(autoincrement())
  assignmentId String             @db.Uuid
  riderId      String             @db.Uuid
  lat          Float
  lng          Float
  accuracyM    Float?
  headingDeg   Float?
  speedMps     Float?
  recordedAt   DateTime
  receivedAt   DateTime           @default(now())
  assignment   DeliveryAssignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)

  @@index([assignmentId, recordedAt(sort: Desc)])
  @@index([receivedAt]) // retention sweeper
  @@map("rider_location_updates")
}

// ───────────────────────────── Chat ─────────────────────────────

/// Exists only for an order with an ACCEPTED assignment. Membership is exactly
/// {order.customerId, riderId}; both are re-verified server-side on every join and message.
model OrderChatRoom {
  id           String             @id @default(uuid()) @db.Uuid
  orderId      String             @unique @db.Uuid
  assignmentId String             @unique @db.Uuid
  customerId   String             @db.Uuid
  riderId      String             @db.Uuid
  openedAt     DateTime           @default(now())
  closedAt     DateTime? // set when order reaches a terminal state → read-only
  order        Order              @relation(fields: [orderId], references: [id], onDelete: Cascade)
  assignment   DeliveryAssignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  messages     ChatMessage[]

  @@map("order_chat_rooms")
}

model ChatMessage {
  id              String              @id @default(uuid()) @db.Uuid
  roomId          String              @db.Uuid
  senderId        String              @db.Uuid
  body            String // length-limited in the service layer
  clientMessageId String // idempotency: retries never duplicate
  createdAt       DateTime            @default(now())
  deliveredAt     DateTime?
  readAt          DateTime?
  room            OrderChatRoom       @relation(fields: [roomId], references: [id], onDelete: Cascade)
  sender          User                @relation(fields: [senderId], references: [id], onDelete: Restrict)
  reports         ChatMessageReport[]

  @@unique([roomId, clientMessageId])
  @@index([roomId, createdAt])
  @@map("chat_messages")
}

model ChatMessageReport {
  id         String       @id @default(uuid()) @db.Uuid
  messageId  String       @db.Uuid
  reporterId String       @db.Uuid
  reason     String
  status     ReportStatus @default(OPEN)
  createdAt  DateTime     @default(now())
  message    ChatMessage  @relation(fields: [messageId], references: [id], onDelete: Cascade)
  reporter   User         @relation(fields: [reporterId], references: [id], onDelete: Cascade)

  @@unique([messageId, reporterId])
  @@map("chat_message_reports")
}

// ─────────────────── Payments & financial records ───────────────────

model Payment {
  id             String        @id @default(uuid()) @db.Uuid
  orderId        String        @db.Uuid
  method         PaymentMethod
  provider       String // "cod", "sslcommerz", "bkash", "dev-adapter" …
  status         PaymentStatus @default(PENDING)
  amountMinor    Int
  currency       String        @default("BDT")
  idempotencyKey String        @unique
  providerRef    String? // provider transaction / session id
  failureReason  String?
  initiatedAt    DateTime      @default(now())
  paidAt         DateTime?
  updatedAt      DateTime      @updatedAt
  order          Order         @relation(fields: [orderId], references: [id], onDelete: Restrict)
  refunds        Refund[]

  @@unique([provider, providerRef])
  @@index([orderId, status])
  @@map("payments")
}

/// Raw, verified-then-stored provider callbacks. (provider, eventId) unique → duplicate callbacks are no-ops.
model PaymentWebhookEvent {
  id          String    @id @default(uuid()) @db.Uuid
  provider    String
  eventId     String
  payload     Json
  signatureOk Boolean
  receivedAt  DateTime  @default(now())
  processedAt DateTime?

  @@unique([provider, eventId])
  @@map("payment_webhook_events")
}

model Refund {
  id            String       @id @default(uuid()) @db.Uuid
  paymentId     String       @db.Uuid
  orderId       String       @db.Uuid
  amountMinor   Int
  status        RefundStatus @default(REQUESTED)
  reason        String
  requestedById String?      @db.Uuid
  reviewedById  String?      @db.Uuid
  reviewNote    String?
  providerRef   String?
  requestedAt   DateTime     @default(now())
  reviewedAt    DateTime?
  processedAt   DateTime?
  payment       Payment      @relation(fields: [paymentId], references: [id], onDelete: Restrict)
  order         Order        @relation(fields: [orderId], references: [id], onDelete: Restrict)

  @@index([orderId])
  @@index([status, requestedAt])
  @@map("refunds")
}

model Payout {
  id                 String              @id @default(uuid()) @db.Uuid
  payeeId            String              @db.Uuid // user id of restaurant owner or rider
  payeeRole          Role
  amountMinor        Int
  status             PayoutStatus        @default(PENDING)
  periodStart        DateTime
  periodEnd          DateTime
  reference          String?
  createdAt          DateTime            @default(now())
  paidAt             DateTime?
  restaurantEarnings RestaurantEarning[]
  riderEarnings      RiderEarning[]

  @@index([payeeId, status])
  @@map("payouts")
}

model RestaurantEarning {
  id              String     @id @default(uuid()) @db.Uuid
  orderId         String     @unique @db.Uuid
  restaurantId    String     @db.Uuid
  grossMinor      Int // food subtotal
  commissionMinor Int
  netMinor        Int
  payoutId        String?    @db.Uuid
  createdAt       DateTime   @default(now())
  order           Order      @relation(fields: [orderId], references: [id], onDelete: Restrict)
  restaurant      Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Restrict)
  payout          Payout?    @relation(fields: [payoutId], references: [id], onDelete: SetNull)

  @@index([restaurantId, createdAt])
  @@map("restaurant_earnings")
}

model RiderEarning {
  id                 String       @id @default(uuid()) @db.Uuid
  orderId            String       @unique @db.Uuid
  riderId            String       @db.Uuid
  amountMinor        Int
  cashCollectedMinor Int          @default(0) // cash-on-delivery money the rider collected and owes the platform
  payoutId           String?      @db.Uuid
  createdAt          DateTime     @default(now())
  order              Order        @relation(fields: [orderId], references: [id], onDelete: Restrict)
  rider              RiderProfile @relation(fields: [riderId], references: [userId], onDelete: Restrict)
  payout             Payout?      @relation(fields: [payoutId], references: [id], onDelete: SetNull)

  @@index([riderId, createdAt])
  @@map("rider_earnings")
}

// ───────────────── Promotions, reviews, favorites ─────────────────

model Coupon {
  id                String             @id @default(uuid()) @db.Uuid
  code              String             @unique // stored upper-cased
  type              CouponType
  value             Int // percent (0-100) or minor units; unused for FREE_DELIVERY
  maxDiscountMinor  Int?
  minSubtotalMinor  Int                @default(0)
  startsAt          DateTime
  endsAt            DateTime
  usageLimitTotal   Int?
  usageLimitPerUser Int                @default(1)
  firstOrderOnly    Boolean            @default(false)
  restaurantId      String?            @db.Uuid // null → platform-wide
  isActive          Boolean            @default(true)
  createdAt         DateTime           @default(now())
  restaurant        Restaurant?        @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  redemptions       CouponRedemption[]
  orders            Order[]

  @@index([isActive, startsAt, endsAt])
  @@map("coupons")
}

model CouponRedemption {
  id         String   @id @default(uuid()) @db.Uuid
  couponId   String   @db.Uuid
  userId     String   @db.Uuid
  orderId    String   @unique @db.Uuid
  redeemedAt DateTime @default(now())
  coupon     Coupon   @relation(fields: [couponId], references: [id], onDelete: Restrict)
  user       User     @relation(fields: [userId], references: [id], onDelete: Restrict)
  order      Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([couponId, userId])
  @@map("coupon_redemptions")
}

/// orderId is unique → one review per order. Service layer only allows DELIVERED orders owned by the reviewer.
model Review {
  id               String        @id @default(uuid()) @db.Uuid
  orderId          String        @unique @db.Uuid
  customerId       String        @db.Uuid
  restaurantId     String        @db.Uuid
  riderId          String?       @db.Uuid
  restaurantRating Int // 1..5 (CHECK constraint)
  riderRating      Int?
  comment          String?
  createdAt        DateTime      @default(now())
  order            Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)
  customer         User          @relation(fields: [customerId], references: [id], onDelete: Cascade)
  restaurant       Restaurant    @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  rider            RiderProfile? @relation(fields: [riderId], references: [userId], onDelete: SetNull)

  @@index([restaurantId, createdAt(sort: Desc)])
  @@map("reviews")
}

model Favorite {
  userId       String     @db.Uuid
  restaurantId String     @db.Uuid
  createdAt    DateTime   @default(now())
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  @@id([userId, restaurantId])
  @@map("favorites")
}

// ───────────── Notifications, support, audit, settings ─────────────

model Notification {
  id        String           @id @default(uuid()) @db.Uuid
  userId    String           @db.Uuid
  type      NotificationType
  title     String
  body      String
  data      Json? // deep-link payload, e.g. { orderId }
  readAt    DateTime?
  createdAt DateTime         @default(now())
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt, createdAt(sort: Desc)])
  @@map("notifications")
}

model SupportTicket {
  id          String          @id @default(uuid()) @db.Uuid
  creatorId   String          @db.Uuid
  orderId     String?         @db.Uuid
  category    TicketCategory
  status      TicketStatus    @default(OPEN)
  subject     String
  description String
  assigneeId  String?         @db.Uuid
  resolution  String?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  resolvedAt  DateTime?
  creator     User            @relation("TicketCreator", fields: [creatorId], references: [id], onDelete: Cascade)
  assignee    User?           @relation("TicketAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  order       Order?          @relation(fields: [orderId], references: [id], onDelete: SetNull)
  messages    TicketMessage[]

  @@index([status, category, createdAt])
  @@index([creatorId])
  @@map("support_tickets")
}

model TicketMessage {
  id         String        @id @default(uuid()) @db.Uuid
  ticketId   String        @db.Uuid
  authorId   String        @db.Uuid
  body       String
  isInternal Boolean       @default(false) // admin-only notes
  createdAt  DateTime      @default(now())
  ticket     SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  author     User          @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@index([ticketId, createdAt])
  @@map("ticket_messages")
}

model AuditLog {
  id         String   @id @default(uuid()) @db.Uuid
  actorId    String?  @db.Uuid
  action     String // "restaurant.approve", "auth.login_failed", …
  entityType String?
  entityId   String?
  metadata   Json?
  ip         String?
  createdAt  DateTime @default(now())
  actor      User?    @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([actorId, createdAt])
  @@index([entityType, entityId])
  @@index([action, createdAt])
  @@map("audit_logs")
}

/// Admin-configurable platform values (commission default, service fee, ranking weights, offer timeout…).
model PlatformSetting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt
  updatedBy String?  @db.Uuid

  @@map("platform_settings")
}

/// Admin-defined service areas. Restaurants/addresses outside every active area are never offered.
model ServiceArea {
  id        String                                  @id @default(uuid()) @db.Uuid
  name      String                                  @unique
  isActive  Boolean                                 @default(true)
  polygon   Unsupported("geography(Polygon,4326)")?
  createdAt DateTime                                @default(now())

  @@index([polygon], type: Gist)
  @@map("service_areas")
}
